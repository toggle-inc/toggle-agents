{
  "schema_version": "agent-delivery-contract/v1",
  "result_audience": "authenticated_requester_only",
  "protected_outputs": ["answer", "intermediate_result", "tool_result", "progress", "error", "attachment", "completion_summary"],
  "origin_notification": {"mode": "fixed_receipt_only", "text": "依頼を受け付けました。内容を含む回答は本人専用の会話に送ります。"},
  "recipient_source": "verified_request_actor",
  "missing_private_delivery": "withhold_result_no_origin_fallback",
  "required_guarantees": ["authenticated_actor_binding", "requester_only_visibility", "no_origin_streaming", "idempotent_delivery"],
  "platform_bindings": {
    "success_assist": {"private_surface": "direct_message", "display_term": "DM", "connection_role": "success_assist_conversation", "capability": "requester_private_message"},
    "buzz": {"private_surface": "direct_message", "display_term": "DM", "connection_role": "buzz_conversation", "capability": "requester_private_message"},
    "codex": {"private_surface": "requester_private_conversation", "display_term": "本人専用チャット", "connection_role": "codex_conversation", "capability": "requester_private_reply"}
  },
  "binding_semantics": "Declared capability requirements, not installed tool names or proof of an existing connection. Credentials and actual connection IDs are injected by the trusted host."
}
