FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Explicit allowlist: never include local .deploy files, credentials or tokens.
COPY cloud_auth_app.py authorization_host.py authorization_app.py requester_mcp.py mcp_server.py delivery.json ./
COPY runtime/ ./runtime/
COPY _foundation/ ./_foundation/
RUN useradd --system --uid 10001 --no-create-home expense
USER 10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080
CMD ["python", "cloud_auth_app.py"]
